# Copiez ce fichier en ".env" et changez les valeurs avant de déployer.

# URL de l'API back-end (voir server/) qui gère l'authentification /admin.
# En local avec `npm run dev` dans server/ : http://localhost:4000.
VITE_API_URL=http://localhost:4000

# Optionnel — Google Analytics 4. Laissez vide pour ne charger aucun script
# de suivi. Pour l'activer : créez une propriété GA4 sur analytics.google.com,
# récupérez l'ID de mesure (format "G-XXXXXXXXXX") et collez-le ci-dessous.
VITE_GA_MEASUREMENT_ID=
