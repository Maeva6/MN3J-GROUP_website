# Copiez ce fichier en ".env" dans le dossier server/.

# Base de données Postgres.
# - Avec `docker compose up` (recommandé) : la valeur ci-dessous est de
#   toute façon écrasée par docker-compose.yml (le service "api" pointe
#   automatiquement vers le conteneur "db").
# - En dev "hybride" (API lancée localement avec `npm run dev`, mais
#   Postgres dans Docker) : lancez `docker compose up db` puis gardez la
#   valeur ci-dessous — le port 5432 du conteneur est exposé sur le port
#   5433 de l'hôte (5432 est volontairement évité pour ne pas entrer en
#   conflit avec un éventuel Postgres déjà installé nativement sur la machine).
# Pour la production (ex. Vercel), utilisez une base hébergée (Postgres
# via Neon/Supabase/Vercel Postgres…).
DATABASE_URL="postgresql://mn3j:mn3j_dev_password@localhost:5433/mn3j?schema=public"

# Serveur
PORT=4000
# Si "true", le conteneur Docker exécute le seed automatiquement au démarrage
# (voir docker-entrypoint.sh). Sans effet en dehors de Docker.
SEED_ON_START=false
# Origine(s) autorisée(s) en CORS pour le futur frontend (séparées par des virgules).
CORS_ORIGIN="http://localhost:5173"

# Authentification admin
JWT_SECRET="change-me-before-deploy"
JWT_EXPIRES_IN="8h"

# Compte admin créé par le script de seed (prisma/seed.js)
ADMIN_EMAIL="admin@mn3jgroup.com"
ADMIN_PASSWORD="change-me-before-deploy"

# Envoi d'e-mail (optionnel) lors d'une nouvelle demande de devis.
# Laissez vide pour désactiver : la demande est alors seulement enregistrée en base.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="MN3J-GROUP <no-reply@mn3jgroup.com>"
NOTIFY_EMAIL_TO="mn3jgroup@gmail.com"
